{
  "manifest_version": 3,
  "name": "Multi Chat",
  "version": "2.0.0",
  "description": "Chat with ChatGPT, Gemini, and Claude simultaneously in one window",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Multi Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content/shared.js", "content/chatgpt.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["content/shared.js", "content/gemini.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": ["content/shared.js", "content/claude.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
