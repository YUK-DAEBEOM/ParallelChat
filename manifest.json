{
  "manifest_version": 3,
  "name": "Parallel Chat",
  "version": "1.0.1",
  "description": "Send one message to ChatGPT, Gemini, and Claude at the same time. Compare AI answers side-by-side in a single tab.",
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*",
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://accounts.google.com/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Parallel Chat",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Shift+M",
        "mac": "Command+Shift+M"
      },
      "description": "Open Parallel Chat"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.openai.com/*",
        "https://chatgpt.com/*"
      ],
      "js": ["content/shared.js", "content/chatgpt.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://gemini.google.com/*"
      ],
      "js": ["content/shared.js", "content/gemini.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": ["content/claude-preload.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://claude.ai/*"
      ],
      "js": ["content/shared.js", "content/claude.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
